---
import { Font } from 'astro:assets';
import darkTheme from 'highlight.js/styles/tokyo-night-dark.css?url';
import lightTheme from 'highlight.js/styles/tokyo-night-light.css?url';
import { PLAIN_TEXT } from '../lib/languages';
import '../styles/global.css';

interface Props {
	/** Id of the paste being viewed, if any. */
	pasteId?: string;
	/** Paste content; omitted while the paste is locked. */
	content?: string;
	language?: string;
	/** What to show instead of the editor. */
	gate?: 'locked' | 'not-found';
}

const { pasteId, content = '', language = PLAIN_TEXT.id, gate } = Astro.props;
// Saved pastes are immutable: viewing one locks the editor and its controls.
const readOnly = pasteId !== undefined;
// HTML drops a leading newline inside <textarea>; feed it a sacrificial one.
const leadingNewline = '\n';
const title = pasteId ? `Pastes · ${pasteId}` : 'Pastes';

const card = 'bg-zinc-100 dark:bg-zinc-800 rounded-none border border-zinc-300 dark:border-zinc-700';
const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500';
const control = `${card} h-9 px-3 text-sm dark:text-white ${focusRing} disabled:opacity-50`;
const button = `${control} inline-flex items-center gap-2 whitespace-nowrap cursor-pointer active:opacity-75 duration-100 disabled:cursor-default`;
// Shared by the highlight layer and the textarea so their glyphs line up exactly.
const editorText = 'm-0 p-4 [font-family:inherit] text-sm leading-6 whitespace-pre [tab-size:4] [font-variant-ligatures:none]';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<Font cssVariable="--font-jetbrains" preload />
		<link rel="stylesheet" href={lightTheme} media="(prefers-color-scheme: light)" />
		<link rel="stylesheet" href={darkTheme} media="(prefers-color-scheme: dark)" />
	</head>
	<body class="flex h-dvh flex-col bg-white antialiased dark:bg-zinc-900 dark:text-white">
		<nav class="bg-white dark:bg-zinc-900">
			<div class="flex flex-wrap items-center gap-2 p-4">
				<!-- Below lg the brand row spans the width (GitHub icon on its right); at lg it dissolves into one toolbar row. -->
				<div class="flex w-full items-center lg:contents">
					<a href="/" class="mr-auto text-2xl font-semibold whitespace-nowrap italic dark:text-white">Pastes</a>
					<a
						href="https://github.com/justanotherbyte/pastes"
						target="_blank"
						rel="noopener noreferrer"
						class={`${button} w-9 justify-center px-0 lg:order-last`}
						title="Source on GitHub"
					>
						<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
						<span class="sr-only">Source on GitHub</span>
					</a>
				</div>

				<a href="/" id="new-paste" class={button}>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
					<span class="sr-only sm:not-sr-only">New Paste</span>
				</a>
				<button type="button" id="save-paste" class={button} title="Save (Ctrl+S)" disabled={readOnly}>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
					<span class="sr-only sm:not-sr-only">Save Paste</span>
				</button>

				<div class="relative min-w-0 flex-1 sm:flex-none" id="language-picker">
					<button
						type="button"
						id="language-button"
						disabled={readOnly}
						class={`${button} w-full justify-between sm:w-48`}
						aria-haspopup="listbox"
						aria-expanded="false"
						aria-controls="language-panel"
					>
						<span class="sr-only">Language:</span>
						<span id="language-label" class="truncate">{PLAIN_TEXT.name}</span>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
					</button>
					<div id="language-panel" class={`${card} absolute top-full right-0 z-50 mt-1 w-64 max-w-[calc(100vw-2rem)]`} hidden>
						<input
							id="language-search"
							type="text"
							role="combobox"
							aria-label="Search languages"
							aria-expanded="true"
							aria-controls="language-list"
							aria-autocomplete="list"
							autocomplete="off"
							spellcheck="false"
							placeholder="Search languages…"
							class="w-full border-b border-zinc-300 bg-transparent px-3 py-2 text-sm outline-none placeholder:text-zinc-400 dark:border-zinc-700 dark:placeholder:text-zinc-500"
						/>
						<ul id="language-list" role="listbox" aria-label="Languages" class="max-h-64 overflow-y-auto py-1 text-sm"></ul>
					</div>
				</div>

				<label class="sr-only" for="paste-password">Password (optional)</label>
				<input
					id="paste-password"
					disabled={readOnly}
					type="password"
					autocomplete="new-password"
					placeholder="Password (optional)"
					class={`${control} w-full placeholder:text-zinc-400 sm:w-48 dark:placeholder:text-zinc-500`}
				/>
			</div>
		</nav>

		<main
			id="app"
			class="flex min-h-0 flex-1 flex-col px-4 pb-4"
			data-paste-id={pasteId}
			data-language={language}
		>
			{
				gate === 'locked' && (
					<div id="gate" class="grid flex-1 place-items-center">
						<form id="unlock-form" class={`${card} flex w-full max-w-sm flex-col gap-3 p-4`}>
							<div>
								<div class="dark:text-white">This paste is password protected</div>
								<p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Enter the password to view it.</p>
							</div>
							<label class="sr-only" for="unlock-password">Password</label>
							<input
								id="unlock-password"
								type="password"
								autocomplete="current-password"
								placeholder="Password"
								required
								autofocus
								class={`${control} bg-white placeholder:text-zinc-400 dark:bg-zinc-900 dark:placeholder:text-zinc-500`}
							/>
							<p id="unlock-error" class="text-sm text-zinc-600 dark:text-zinc-400" role="alert" hidden />
							<button type="submit" class={`${button} justify-center`}>Unlock</button>
						</form>
					</div>
				)
			}
			{
				gate === 'not-found' && (
					<div id="gate" class="grid flex-1 place-items-center">
						<div class={`${card} w-full max-w-sm p-4`}>
							<div class="dark:text-white">Paste not found</div>
							<p class="mt-1 text-zinc-600 dark:text-zinc-400">
								It may have never existed.{' '}
								<a href="/" class="font-semibold text-blue-500 underline duration-200 hover:text-blue-700">Start a new paste</a>.
							</p>
						</div>
					</div>
				)
			}

			<div id="editor" class={`${card} relative min-h-0 flex-1 overflow-auto`} hidden={gate !== undefined}>
				<!-- The textarea and highlight layer share one grid cell; the <pre> sizes it, the textarea fills it. -->
				<div class="grid min-h-full w-max min-w-full">
					<pre id="highlight" aria-hidden="true" class={`${editorText} pointer-events-none [grid-area:1/1] text-zinc-800 dark:text-zinc-200`}><code id="highlight-code" class="[font:inherit]">{content}</code></pre>
					<textarea
						id="paste-input"
						aria-label="Paste content"
						placeholder="Paste or type something…"
						wrap="off"
						spellcheck="false"
						autocapitalize="off"
						autocomplete="off"
						autofocus={gate === undefined}
						readonly={readOnly}
						class={`${editorText} resize-none overflow-hidden border-0 bg-transparent text-transparent caret-black outline-none [grid-area:1/1] placeholder:text-zinc-400 selection:bg-zinc-300 dark:caret-white dark:placeholder:text-zinc-500 dark:selection:bg-zinc-600`}
					>{leadingNewline + content}</textarea>
				</div>
			</div>

			<div class="flex justify-between gap-4 pt-2 text-xs text-zinc-500">
				<span id="status" role="status" aria-live="polite" class="truncate"></span>
				<span id="meta" class="whitespace-nowrap"></span>
			</div>
		</main>

		<script>
			import '../scripts/editor';
		</script>
	</body>
</html>
